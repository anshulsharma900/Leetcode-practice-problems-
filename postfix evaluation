class Solution {
  public:
  int floorDiv(int a, int b){
      int res = a/b;
      
      if((a^b)<0 && a%b !=0){
          res--;
      }
      return res;
  }
    int evaluatePostfix(vector<string>& arr) {
        int n = arr.size();
        stack<int> st;
        
        for(int i=0; i<n; i++){
            string token = arr[i];
            
            if(token=="+" || token=="-" || token=="*" || token=="/"  || token=="^"){
                int op2 = st.top(); st.pop();
                int op1 = st.top(); st.pop();
                
                if(token=="+")
                st.push(op1+op2);
                else if(token=="-")
                st.push(op1-op2);
                else if(token=="*")
                st.push(op1*op2);
                else if(token=="/")
                st.push(floorDiv(op1,op2));
                else if(token=="^")
                st.push((int)pow(op1,op2));
            }
            else{
                st.push(stoi(token));
            }
        }
        return st.top();
        
    }
}; 