class Solution {
public:
    int maxSum(vector<int>& nums, int n){
        int sum=nums[0];
        int maxSum = nums[0];

        for(int i=1; i<n; i++){
            sum = max(nums[i], sum + nums[i]);
            maxSum = max(maxSum, sum);
        }
        return maxSum;
    }
    int minSum(vector<int>& nums, int n){
        int sum = nums[0];
        int minSum = nums[0];

        for(int i=0; i<n; i++){
            sum =  min(nums[i], sum + nums[i]); 
            minSum = min(sum, minSum);
        }
        return minSum;
    }

    int maxSubarraySumCircular(vector<int>& nums) {
        int n = nums.size();
        int normalMax = maxSum(nums,n);
        if (normalMax < 0)
            return normalMax;

        int totalSum = 0;
        for (int i = 0; i < n; i++) {
            totalSum += nums[i];
        }

        int circularMax = totalSum - minSum(nums, n);

        return max(normalMax, circularMax);

        
    }
};