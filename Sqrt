class Solution {
public:
    int mySqrt(int x) {
        if(x<2) return x;
        int start=1, end=x/2;
        int res=0;

        while(start<=end){
            long long  mid = start+(end-start)/2;

            if(mid*mid<=x){
                res=mid;
                start=mid+1;
            }
            else{
                end=mid-1;
            }
        }
        return res;


        // int n= sqrt(x);
        //  return n;

    
        
    }
};