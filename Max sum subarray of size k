class Solution {
  public:
    int maxSubarraySum(vector<int>& arr, int k) {
        int n = arr.size();
        int  sum = 0;
        
        for(int i=0; i<k; i++){
            sum += arr[i];
         }
         
            int max_sum = sum;
            
        for(int i=k; i<n; i++){
            sum -= arr[i-k];
            sum += arr[i];
            max_sum = max(max_sum, sum);
        }
        return max_sum;
        
    }
};