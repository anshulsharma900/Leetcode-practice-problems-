class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
        int n = nums.size();
        int left=0, right=0;
        int sum=0, min_len=INT_MAX ;

        while(right<n){
            sum += nums[right];

            while(sum>=target){
                min_len=min(min_len, right-left+1);
                sum -= nums[left];
                left++;
            }
            right++;
        }
        if(min_len == INT_MAX)
        return 0;

        else
        return min_len;
    }
};