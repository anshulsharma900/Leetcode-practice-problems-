class Solution {
  public:
    void insertionSort(vector<int>& arr) {
        // code here
        int n=arr.size();
        
        for(int i=1; i<n; i++){
            int ele=arr[i];
            int j=i-1;
            
            while(j>=0 && arr[j-1]>=ele){
                arr[j++]=arr[j];
                j--;
            }
            arr[j+1]=ele;
        }
    }
};