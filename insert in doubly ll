class Solution {
  public:
    Node *insertAtPos(Node *head, int p, int x) {
        Node* newNode = new Node(x);
        Node* curr = head;
        for(int i=0; i<pos; i++){
            curr = curr->next;
        }
        curr->next = newNode;
        
    }
};